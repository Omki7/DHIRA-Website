# Copy to .env.local for local overrides. Every variable is read in lib/env.ts.

# Canonical origin for metadata, sitemap.xml and structured data.
# Set it on preview deployments so canonical URLs point at the preview host.
NEXT_PUBLIC_SITE_URL=https://www.dhira.ai

# When a CMS is connected, its server-only credentials go here (no
# NEXT_PUBLIC_ prefix) and are declared in lib/env.ts. See docs/CONTENT.md.
