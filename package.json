{
  "name": "dhira-website-v3",
  "version": "1.0.0",
  "private": true,
  "description": "DHIRA company website: Next.js App Router, content-driven and CMS-ready.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run knip"
  },
  "dependencies": {
    "framer-motion": "^12.42.2",
    "next": "^16.4.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "server-only": "0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.4",
    "eslint-config-prettier": "10.1.8",
    "knip": "5.88.1",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "sass": "1.83.4",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
